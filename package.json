    "release": "bun run script/release.ts",
    "typecheck": "bun check --no-script"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.5",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.13",
    "bun": "1.4.4-canary.20261030.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.5"
  },
  "packageManager": "bun@1.4.4"
}
