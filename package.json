{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "mute",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "mute": "./src/index.ts"
  },
  "scripts": {
    "check": "bun fmt --check && bun lint",
